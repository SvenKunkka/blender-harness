# ---------------------------------------------------------------------------
# Blender Harness — environment configuration (copy to .env and edit)
# All values are optional; sensible defaults apply when unset.
# ---------------------------------------------------------------------------

# ---- Server ---------------------------------------------------------------
HARNESS_HOST=127.0.0.1
HARNESS_PORT=9876
# Where the server stores SQLite history + screenshots/checkpoints metadata.
HARNESS_DATA_DIR=./data
LOG_LEVEL=INFO
DEBUG=false

# ---- Agent loop limits ----------------------------------------------------
MAX_AGENT_STEPS=20
MAX_VISION_REFINEMENTS=3
# Blender tool timeout in seconds (per tool call)
BLENDER_TOOL_TIMEOUT_S=120
# Give sandboxed `execute_blender_python` to the model at all? false = safer.
ALLOW_EXECUTE_PYTHON=false

# ---- AI provider (any OpenAI-compatible endpoint) --------------------------
# OpenAI        https://api.openai.com/v1
# DeepSeek      https://api.deepseek.com/v1
# Qwen (DashScope compatible-mode) https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenRouter    https://openrouter.ai/api/v1
# LM Studio     http://127.0.0.1:1234/v1
# Ollama        http://127.0.0.1:11434/v1   (any key works, e.g. "ollama")
# vLLM          http://127.0.0.1:8000/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional separate vision model for screenshot review. Leave empty to reuse
# AI_MODEL when it supports image input. Set to "" to disable vision checks.
AI_VISION_BASE_URL=
AI_VISION_API_KEY=
AI_VISION_MODEL=

# Optional HTTP proxy / extra headers for the LLM client
# AI_EXTRA_HEADERS={"Authorization":"Bearer ..."}
